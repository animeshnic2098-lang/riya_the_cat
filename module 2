1. Контроллер домена Samba DC на BR-SRV
bash
# Установка Samba
apt-get update && apt-get install -y task-samba-dc

# Остановка и отключение стандартных служб (мешают)
systemctl stop smb nmb winbind
systemctl disable smb nmb winbind

# Подготовка домена au-team.irpo
samba-tool domain provision --use-rfc2307 --realm=AU-TEAM.IRPO --domain=AU-TEAM --adminpass=P@ssw0rd --server-role=dc --dns-backend=SAMBA_INTERNAL

# Перемещаем и настраиваем конфиг
mv /etc/samba/smb.conf /etc/samba/smb.conf.bak
cp /var/lib/samba/private/smb.conf /etc/samba/

# Запускаем Samba DC
systemctl unmask samba-ad-dc
systemctl enable samba-ad-dc
systemctl start samba-ad-dc

# Настройка DNS-резолвера клиента (чтобы сам BR-SRV видел свой домен)
cat > /etc/net/ifaces/ens18/resolv.conf << EOF
search au-team.irpo
nameserver 127.0.0.1
nameserver 192.168.2.2
EOF
systemctl restart network

# Создание 5 пользователей hquser1-5 и группы hq
for i in {1..5}; do
    samba-tool user create hquser$i P@ssw0rd
done
samba-tool group add hq
for i in {1..5}; do
    samba-tool group addmembers hq hquser$i
done

# Ввод машины HQ-CLI в домен (выполнить на HQ-CLI)
# (Прописано отдельным блоком ниже)
На HQ-CLI (ввод в домен):

bash
apt-get update && apt-get install -y task-auth-ad-client
realm join --user=administrator au-team.irpo
# пароль Administrator: P@ssw0rd (установлен при provision)

# Настройка автоматического входа пользователей домена (вход по паролю)
cat > /etc/sssd/sssd.conf << EOF
[sssd]
domains = au-team.irpo
config_file_version = 2
services = nss, pam

[domain/au-team.irpo]
ad_domain = au-team.irpo
krb5_realm = AU-TEAM.IRPO
realmd_tags = manages-system joined-with-adcli
cache_credentials = True
id_provider = ad
krb5_store_password_if_offline = True
default_shell = /bin/bash
ldap_id_mapping = True
use_fully_qualified_names = False
fallback_homedir = /home/%u
access_provider = ad
ad_access_filter = (|(memberOf=CN=hq,CN=Users,DC=au-team,DC=irpo))
EOF
chmod 600 /etc/sssd/sssd.conf
systemctl restart sssd

# Настройка sudo для группы hq (ограниченные команды)
echo '%hq ALL=(ALL) /bin/cat, /bin/grep, /usr/bin/id' > /etc/sudoers.d/hq-group
📌 Пояснения:
Samba DC работает как контроллер домена Active Directory. samba-tool domain provision создаёт домен au-team.irpo.

На HQ-CLI настраивается SSSD с ad_access_filter, который разрешает вход только членам группы hq.

В sudoers указаны строго три команды (cat, grep, id) – остальные с sudo запускать нельзя.

2. RAID 0 (дисковый массив) на HQ-SRV
Предполагается, что два диска – /dev/sdb и /dev/sdc (по 1 ГБ). Проверьте имена: lsblk.

bash
# Установка mdadm
apt-get update && apt-get install -y mdadm

# Создание RAID 0 из двух дисков
mdadm --create /dev/md0 --level=0 --raid-devices=2 /dev/sdb /dev/sdc

# Сохранение конфигурации
mdadm --detail --scan >> /etc/mdadm.conf
update-initramfs -u

# Создание файловой системы ext4 на /dev/md0
mkfs.ext4 /dev/md0

# Создание точки монтирования
mkdir /raid

# Автомонтирование при загрузке
echo "/dev/md0 /raid ext4 defaults 0 0" >> /etc/fstab

# Монтирование сейчас
mount /raid
📌 Пояснение:
RAID 0 (striping) – повышает производительность, но не отказоустойчив. Для учебных целей допустим.

mdadm.conf хранит описание массива, чтобы он автоматически собирался при загрузке.

3. NFS-сервер на HQ-SRV и автомонтирование на HQ-CLI
На HQ-SRV:

bash
# Установка NFS-сервера
apt-get update && apt-get install -y nfs-utils

# Создание папки для экспорта
mkdir -p /raid/nfs
chmod 777 /raid/nfs

# Экспорт только для сети HQ-CLI (192.168.2.32/27)
echo "/raid/nfs 192.168.2.32/27(rw,sync,no_subtree_check,no_root_squash)" >> /etc/exports

# Запуск и включение сервисов
systemctl enable --now nfs-server
exportfs -a
На HQ-CLI:

bash
# Установка autofs
apt-get update && apt-get install -y autofs nfs-utils

# Настройка автомонтирования
mkdir /mnt/nfs
cat > /etc/auto.master << EOF
/mnt/nfs /etc/auto.nfs --timeout=60
EOF

cat > /etc/auto.nfs << EOF
nfs -fstype=nfs,rw,vers=3 192.168.2.2:/raid/nfs
EOF

systemctl restart autofs

# Проверка: cd /mnt/nfs/nfs (должно смонтироваться автоматически)
📌 Пояснение:
no_root_squash разрешает root клиента доступ с правами root на сервере – для упрощения.

Autofs монтирует при обращении и отмонтирует через 60 секунд простоя.

