#!/bin/bash
set -e

# Создаём каталоги интерфейсов
mkdir -p /etc/net/ifaces/ens19
mkdir -p /etc/net/ifaces/ens20

# Настройка ens19 (172.16.1.1/28)
cat > /etc/net/ifaces/ens19/options << EOF
TYPE=eth
BOOTPROTO=static
HOST=ens19
EOF
echo "172.16.1.1/28" > /etc/net/ifaces/ens19/ipv4address

# Настройка ens20 (172.16.2.1/28)
cat > /etc/net/ifaces/ens20/options << EOF
TYPE=eth
BOOTPROTO=static
HOST=ens20
EOF
echo "172.16.2.1/28" > /etc/net/ifaces/ens20/ipv4address

# Включаем IP-форвардинг (маршрутизацию)
sed -i 's/^net.ipv4.ip_forward\s*=\s*.*/net.ipv4.ip_forward = 1/' /etc/net/sysctl.conf
grep -q "^net.ipv4.ip_forward" /etc/net/sysctl.conf || echo "net.ipv4.ip_forward = 1" >> /etc/net/sysctl.conf
sysctl -p /etc/net/sysctl.conf

# Перезапускаем сеть, чтобы поднять интерфейсы
systemctl restart network

# Часовой пояс (Москва)
apt-get update
apt-get install -y tzdata
timedatectl set-timezone Europe/Moscow

# Установка iptables и правила NAT (маскарадинг через ens18)
apt-get install -y iptables
iptables -t nat -A POSTROUTING -o ens18 -j MASQUERADE

# Разрешаем маршрутизацию между ens19/ens20 и ens18
iptables -A FORWARD -i ens19 -o ens18 -j ACCEPT
iptables -A FORWARD -i ens20 -o ens18 -j ACCEPT
iptables -A FORWARD -i ens18 -o ens19 -j ACCEPT
iptables -A FORWARD -i ens18 -o ens20 -j ACCEPT

# Сохраняем правила iptables (путь для ALT Linux)
mkdir -p /etc/sysconfig
iptables-save > /etc/sysconfig/iptables

# Включаем автозагрузку iptables и запускаем
systemctl enable iptables
systemctl start iptables

# Финальный перезапуск сети
systemctl restart network

# Проверка NAT
iptables -t nat -L -n -v
