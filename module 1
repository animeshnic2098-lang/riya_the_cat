🐧 HQ-SRV (ALT Linux)
bash
hostnamectl set-hostname hq-srv.au-team.irpo
cat > /etc/net/ifaces/ens18/options << EOF
BOOTPROTO=static
TYPE=eth
CONFIG_WIRELESS=no
SYSTEMD_BOOTPROTO=static
CONFIG_IPV4=yes
DISABLED=no
NM_CONTROLLED=no
SYSTEMD_CONTROLLED=no
EOF
echo 192.168.2.2/27 > /etc/net/ifaces/ens18/ipv4address
echo default via 192.168.2.1 > /etc/net/ifaces/ens18/ipv4route
cat > /etc/net/ifaces/ens18/resolv.conf << EOF
search au-team.irpo
nameserver 77.88.8.8
EOF
systemctl restart network
timedatectl set-timezone Europe/Moscow
useradd -s /bin/bash -u 2026 sshuser
echo "sshuser:P@ssw0rd" | chpasswd
gpasswd -a sshuser wheel
echo 'sshuser ALL = (root) NOPASSWD: ALL' >> /etc/sudoers
sed -i 's/^#Port 22/Port 2026/' /etc/openssh/sshd_config
sed -i 's/^#MaxAuthTries 6/MaxAuthTries 2/' /etc/openssh/sshd_config
echo "Banner /etc/openssh/banner" >> /etc/openssh/sshd_config
echo "AllowUsers sshuser" >> /etc/openssh/sshd_config
echo "Authorized access only" > /etc/openssh/banner
systemctl restart sshd
apt-get update && apt-get install dnsmasq -y
echo 'OPTIONS=""' > /etc/sysconfig/dnsmasq
cat > /etc/dnsmasq.conf << EOF
no-resolv
no-poll
no-hosts
server=77.88.8.7
server=195.208.4.1
server=8.8.8.8
cache-size=1000
all-servers
no-negcache
host-record=hq-rtr.au-team.irpo,192.168.2.1
ptr-record=1.2.168.192.in-addr.arpa,hq-rtr.au-team.irpo
host-record=hq-srv.au-team.irpo,192.168.2.2
ptr-record=2.2.168.192.in-addr.arpa,hq-srv.au-team.irpo
host-record=hq-cli.au-team.irpo,192.168.2.34
ptr-record=34.2.168.192.in-addr.arpa,hq-cli.au-team.irpo
address=/br-rtr.au-team.irpo/192.168.3.1
address=/br-srv.au-team.irpo/192.168.3.2
address=/docker.au-team.irpo/172.16.1.1
address=/web.au-team.irpo/172.16.2.1
EOF
systemctl enable --now dnsmasq
